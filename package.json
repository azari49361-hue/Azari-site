{
  "name": "azari-trade-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AZARI TRADE AI — سامانه تحلیل و سیگنال طلا (XAUUSD) با منابع قیمت واقعی، موتور چند تایم‌فریمی، تلگرام تفکیک‌شده کانال/گروه و ذخیره‌سازی PostgreSQL",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "migrate": "tsx server/db/migrate.ts",
    "test": "vitest run",
    "check:pwa": "node scripts/check-pwa.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "exa-js": "2.28.0",
    "express": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
