# ============================================================
# AZARI TRADE AI — متغیرهای محیطی (کپی کنید به .env و مقادیر را بگذارید)
# هیچ کلیدی در کد ذخیره نمی‌شود؛ همه کلیدها فقط از همین متغیرها خوانده می‌شوند.
# ============================================================

# --- اجباری در production: رمز ورود داشبورد ---
# بدون این رمز، هر کسی که آدرس سایت را داشته باشد می‌تواند تنظیمات تلگرام را عوض کند.
# در NODE_ENV=production نبودنش باعث توقف سرور با پیام FATAL می‌شود.
# نشست بعد از ورود ۳۰ روز در یک کوکی HttpOnly معتبر است (رمز در مرورگر ذخیره نمی‌شود).

# --- اجباری: دیتابیس PostgreSQL ---
DATABASE_URL=postgres://azari:change-me@localhost:5432/azaritrade

# --- پورت سرور (پیش‌فرض 3000) ---
PORT=3000

# آدرس عمومی سایت برای پیش‌نمایش لینک در تلگرام/توییتر (Open Graph).
# خالی بگذارید تا از هدرهای همان درخواست ساخته شود؛ پشت nginx بهتر است صریح باشد:
# PUBLIC_BASE_URL=https://azari.example.com
PUBLIC_BASE_URL=

# --- منابع قیمت (حداقل یکی؛ ترتیب اولویت: MetaApi ← Twelve Data ← biquote) ---

# MetaApi (اتصال واقعی متاتریدر ۵) — در صورت عدم تنظیم، سیستم بدون آن و با منابع بعدی کار می‌کند
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# هاست REST متناسب با منطقه حساب شما (پیش‌فرض منطقه new-york):
METAAPI_REST_HOST=https://mt-client-api-v1.new-york.agiliumtrade.ai

# Twelve Data (پشتیبان) — کلید از twelvedata.com
TWELVEDATA_API_KEY=
# حداقل فاصله بین دو درخواست TwelveData (ثانیه). پلن رایگان: 60 (۴ کردیت در دقیقه). پلن پولی: 0
TWELVEDATA_MIN_INTERVAL_SECONDS=60

# biquote (منبع عمومی رایگان، بدون کلید — به‌صورت پیش‌فرض فعال)
BIQUOTE_ENABLED=true

# --- تلگرام (توکن در تنظیمات دیتابیس ذخیره می‌شود) ---
# راهنما: docs/SETUP.md
# TELEGRAM_BOT_TOKEN از @BotFather — پس از اولین اجرا از طریق داشبورد هم قابل تنظیم است.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# چت شخصی مالک برای هشدارهای فنی (کهنگی داده). خالی = فقط از داشبورد تنظیم شود.
TELEGRAM_ADMIN_CHAT_ID=

# --- رفتار موتور ---
# حداقل فاصله دو سیگنال طلا (ثانیه)
GOLD_COOLDOWN_SECONDS=300
# حداقل فاصله سایر نمادها (ثانیه)
SYMBOL_COOLDOWN_SECONDS=600
# حداکثر سن داده قیمت برای «زنده» بودن (ثانیه)
QUOTE_MAX_AGE_SECONDS=300
# حداکثر نسبت اسپرد به ATR کندل یک‌دقیقه (۰.۲ = ۲۰٪) — بالاتر از این، ورود بی‌کیفیت رد می‌شود
MAX_SPREAD_ATR_RATIO=0.2
# فاصله پیش‌سیگنال تا ارسال سیگنال اصلی به کانال (ثانیه)
PRE_SIGNAL_DELAY_SECONDS=15
# چرخه اسکن خودکار بازار (ثانیه) — برای M1 مقدار ۱۵ توصیه می‌شود
SCAN_INTERVAL_SECONDS=15

# --- گزارش دوره‌ای بازار به کانال (بدون سیگنال) ---
# فعال/غیرفعال کردن گزارش
REPORT_ENABLED=true
# فاصله ارسال (ساعت) — ساعت‌های ۰، ۳، ۶… به وقت تهران
REPORT_INTERVAL_HOURS=3
# نرخ دلار/تومان به‌صورت خودکار از بازار آزاد خوانده می‌شود (priceto.day → nerkhsanj → Nobitex).
# این مقدار فقط «پشتیبان» است: اگر همهٔ منابع خودکار پاسخ ندهند، همین عدد در گزارش می‌آید. 0 = بدون پشتیبان
USD_TOMAN_RATE=0

# --- جستجوی وب Exa (اختیاری) ---
# کلید از dashboard.exa.ai/api-keys — بدون کلید، مسیر /api/web-search با خطای 503 پاسخ می‌دهد.
EXA_API_KEY=
